---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

const ingredients = await getCollection('ingredients');
const orderedIngredients = ingredients.sort((a, b) => a.data.title.localeCompare(b.data.title));
---

<BaseLayout
  title="LanDeng — Chinese Incense Materials, Grading & Craft Notes"
  description="Field notes on Chinese incense: 150 botanicals, the grades they are sold under, the blends they enter, and the sources behind every claim. No catalog, no checkout."
>
  <section class="hero">
    <div class="shell hero-inner">
      <p class="eyebrow">Chinese incense knowledge · 香 · 合香 · 香道</p>
      <h1>LanDeng <span>澜灯</span></h1>
      <p class="lede">
        Field notes on Chinese incense: the materials, the grades they are sold under, the
        blends they go into, and the evidence behind each statement.
      </p>
      <img src="/images/home-hero-botanical-still-life-1600x900.webp" alt="Incense smoke rising from a dark ceramic censer surrounded by botanical materials and brass tools, warm amber light" width="1600" height="900">
      <p class="hero-note">
        No catalog and no checkout. Where a claim cannot be sourced, the page says so rather
        than repeating it.
      </p>
      <a class="text-link" href="/ingredients/">Browse the ingredient reference <span aria-hidden="true">→</span></a>
    </div>
  </section>

  <section class="section what-is">
    <div class="shell prose">
      <p class="section-label">Positioning</p>
      <h2>A reference with a paper trail</h2>
      <p>
        LanDeng documents Chinese incense for people who have to check a claim rather than repeat
        it. Each entry answers four questions in order: what the material is, how it is graded,
        what it is routinely confused with, and which part of the answer rests on a text rather
        than a measurement.
      </p>
      <p>
        The range runs from ordinary cedar to protected <a href="/ingredients/thuja/">崖柏</a>.
        Grade names are handled as claims with methods attached: 沉水 is a density test, 奇楠 a
        set of observed characteristics, 老山檀 an age and origin statement that most sellers
        cannot document.
      </p>
      <a class="text-link" href="/ingredients/">Browse the ingredient encyclopedia <span aria-hidden="true">→</span></a>
      <img class="section-img" src="/images/home-what-is-materials-1200x675.webp" alt="The five Chinese incense material families — woods, resins, flowers, herbs and spices — arranged on rice paper" width="1200" height="675" loading="lazy">
    </div>
  </section>

  <section class="section topics">
    <div class="shell">
      <div class="section-heading">
        <p class="section-label">Content entry points</p>
        <h2>Start from the question you have</h2>
      </div>
      <p class="topics-lede">
        Seven domains, each a different way in. None of them requires reading the others first.
      </p>
      <div class="topic-grid">
        <a class="topic-card" href="/chinese-incense/">
          <span class="card-kicker">Domain 1</span>
          <h3>Materials, one entry at a time</h3>
          <p>150 botanicals — woods, resins, flowers, herbs, spices — with pinyin, origin, grade and the adulterants to check for.</p>
        </a>
        <a class="topic-card" href="/blog/incense-authentication-database/">
          <span class="card-kicker">Domain 2</span>
          <h3>Telling real from treated</h3>
          <p>Grade claims read as claims to test: the density check, the resin lines, the substitutions and how each is caught.</p>
        </a>
        <a class="topic-card" href="/blog/agarwood-incense/">
          <span class="card-kicker">Domain 3</span>
          <h3>Why resin forms at all</h3>
          <p>Wounding, fungal response and the years between a healthy tree and a bead of agarwood.</p>
        </a>
        <a class="topic-card" href="/blog/how-incense-is-made/">
          <span class="card-kicker">Domain 4</span>
          <h3>From fibre to stick</h3>
          <p>Grinding, sieving, blending, forming, drying, curing — what each step changes in the finished stick.</p>
        </a>
        <a class="topic-card" href="/blog/scent-guide/">
          <span class="card-kicker">Domain 5</span>
          <h3>Scent, described honestly</h3>
          <p>Ten aroma families and a working vocabulary for choosing by atmosphere instead of by label.</p>
        </a>
        <a class="topic-card" href="/blog/what-is-chinese-incense/">
          <span class="card-kicker">Domain 6</span>
          <h3>The texts and the canon</h3>
          <p>香道, the Four Leisure Arts, the 香谱 manuals, and what the Song–Ming canon actually records.</p>
        </a>
        <a class="topic-card" href="/blog/hexiang-blending-system/">
          <span class="card-kicker">Domain 7</span>
          <h3>How a 合香 is composed</h3>
          <p>Chief, minister, assistant, guide: the role each material plays inside a formula, and why order matters.</p>
        </a>
      </div>
    </div>
  </section>

  <section class="section explore">
    <div class="shell">
      <div class="section-heading">
        <div>
          <p class="section-label">Explore by entity</p>
          <h2>The material index</h2>
        </div>
        <a class="text-link" href="/ingredients/">View all ingredients</a>
      </div>

      <img class="section-img" src="/images/home-explore-tea-table-1200x675.webp" alt="A lit incense stick in a ceramic censer beside a cup of tea on a warm wood table" width="1200" height="675" loading="lazy">

      <p class="topics-lede">
        A starter shelf of 24 entries, chosen across the families; the full index runs to 150.
      </p>

      {
        orderedIngredients.length > 0 ? (
          <div class="card-grid">
            {orderedIngredients.slice(0, 24).map((entry) => (
              <a class="entity-card" href={`/ingredients/${entry.id}/`}>
                <span class="card-kicker">{entry.data.type}</span>
                <h3>{entry.data.chinese} <span>{entry.data.pinyin}</span></h3>
                <p class="card-name">{entry.data.title}</p>
                <p class="card-scientific">{entry.data.scientificName}</p>
                <p class="aroma" aria-label="Aroma notes">
                  {entry.data.aroma.join(' · ')}
                </p>
              </a>
            ))}
          </div>
        ) : (
          <p class="empty-note">Ingredient entries will appear here as they are published.</p>
        )
      }
    </div>
  </section>

  <section class="section trust">
    <div class="shell prose">
      <p class="section-label">Editorial standard</p>
      <h2>How these notes are made</h2>
      <p>
        Every entry keeps a visible split between what the classical texts say, what the trade
        repeats, and what has actually been measured. Sources are named, open questions stay open,
        and the byline is the editorial team rather than a borrowed expert.
      </p>
      <ul class="trust-list">
        <li>A traditional claim stays labelled traditional; it is never promoted to fact.</li>
        <li>A number without a method is removed, not rounded into something plausible.</li>
        <li>Entity pages publish machine-readable definitions so search engines and AI systems can quote them accurately.</li>
        <li>No health claims: incense is documented as aroma, craft and culture.</li>
      </ul>
      <a class="text-link" href="/blog/landeng-editorial-methodology/">How this site researches Chinese incense <span aria-hidden="true">→</span></a>
      <img class="section-img" src="/images/home-trust-censer-tools-1200x675.webp" alt="Traditional Chinese incense utensils arranged on a bamboo tray beside a small censer" width="1200" height="675" loading="lazy">
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    padding-block: clamp(4rem, 10vw, 8rem) clamp(3rem, 8vw, 6rem);
  }

  .hero-inner {
    max-width: 62rem;
  }

  .eyebrow,
  .section-label,
  .card-kicker {
    margin: 0 0 var(--space-2);
    color: var(--jade);
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .hero .eyebrow {
    margin-bottom: 0;
  }

  .hero h1 {
    margin-bottom: var(--space-3);
  }

  .hero h1 span {
    color: var(--ink-soft);
    font-weight: 400;
  }

  .hero h1,
  .hero .lede {
    text-wrap: balance;
  }

  .lede {
    font-family: var(--serif);
    font-size: clamp(1.25rem, 2.6vw, 1.65rem);
    line-height: 1.45;
  }

  .hero-note {
    color: var(--ink-soft);
    font-size: 0.95rem;
  }

  .section {
    padding-block: var(--space-6);
    border-top: 1px solid var(--line);
  }

  .what-is {
    background: var(--paper-raise);
  }

  .section-heading {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: var(--space-3);
    margin-bottom: var(--space-4);
  }

  .section-heading h2 {
    margin: 0;
  }

  .topics-lede {
    max-width: 44rem;
    color: var(--ink-soft);
    margin-bottom: var(--space-4);
  }

  .topic-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr));
    gap: var(--space-3);
  }

  .topic-card {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    padding: var(--space-4);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--paper-raise);
    color: var(--ink);
    text-decoration: none;
    transition: border-color 180ms ease, transform 180ms ease;
  }

  .topic-card:hover {
    border-color: var(--amber);
    transform: translateY(-2px);
  }

  .topic-card h3 {
    margin: 0;
    font-size: 1.25rem;
  }

  .topic-card p {
    margin: 0;
    color: var(--ink-soft);
    font-size: 0.94rem;
  }

  .card-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr));
    gap: var(--space-3);
  }

  .entity-card {
    display: flex;
    flex-direction: column;
    min-height: 13rem;
    padding: var(--space-4);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--paper-raise);
    color: var(--ink);
    text-decoration: none;
    transition: border-color 180ms ease, transform 180ms ease;
  }

  .entity-card:hover {
    border-color: var(--amber);
    transform: translateY(-2px);
  }

  .entity-card h3 {
    margin: 0 0 var(--space-1);
    font-size: 1.9rem;
  }

  .entity-card h3 span {
    color: var(--ink-soft);
    font-size: 1rem;
    font-weight: 400;
  }

  .card-name {
    margin: 0 0 var(--space-1);
    color: var(--ink-soft);
  }

  .card-scientific {
    margin: 0 0 var(--space-3);
    color: var(--jade);
    font-style: italic;
    font-size: 0.95rem;
  }

  .aroma {
    margin: auto 0 0;
    color: var(--ink-soft);
    font-size: 0.9rem;
    letter-spacing: 0.02em;
  }

  .trust-list {
    padding-left: 1.2rem;
  }

  .trust-list li {
    margin-bottom: var(--space-1);
  }

  .empty-note {
    color: var(--ink-soft);
  }

  .section-img {
    display: block;
    max-width: 100%;
    width: min(100%, 48rem);
    margin: var(--space-4) auto var(--space-5);
    border-radius: 8px;
    box-shadow: 0 1px 2px rgba(28, 26, 23, 0.06), 0 6px 20px -8px rgba(28, 26, 23, 0.12);
  }

  @media (max-width: 44rem) {
    .section-heading {
      align-items: start;
      flex-direction: column;
    }

    .hero .text-link,
    .section-heading .text-link {
      width: 100%;
      justify-content: center;
    }
  }
</style>
