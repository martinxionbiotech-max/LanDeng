---
import BaseLayout from '../../layouts/BaseLayout.astro';
const SITE = Astro.site?.toString() ?? 'https://example.com';
---

<BaseLayout
  title="Wholesale Chinese Botanical Incense — LanDeng"
  description="Wholesale inquiries for Chinese botanical incense — sticks, cones, sachets, and materials. Contact LanDeng for product range, MOQ, and specifications."
>
  <article class="article">
    <h1>Wholesale</h1>
    <p class="lead">
      LanDeng supplies Chinese botanical incense for wholesale and bulk orders. We work with
      natural materials — woods, resins, herbs and flowers — across stick, cone, sachet and raw-material
      formats.
    </p>

    <h2>What we supply</h2>
    <ul>
      <li><strong>Incense sticks</strong> (线香) — the common modern format</li>
      <li><strong>Incense cones</strong> (塔香) and <strong>coils</strong> (盘香)</li>
      <li><strong>Sachets</strong> (香囊)</li>
      <li><strong>Raw materials</strong> (香材) — woods, resins, herbs</li>
    </ul>

    <h2>How to inquire</h2>
    <p>
      To prepare an accurate quote, please tell us:
    </p>
    <ul>
      <li>Product format and any specific ingredient(s) or aroma profile</li>
      <li>Target quantity</li>
      <li>Destination country/port</li>
      <li>Any packaging or specification requirements</li>
    </ul>

    <h2>Confirmations we provide on inquiry</h2>
    <p>
      Because specifications vary by product and order, we confirm the following per inquiry rather
      than publishing fixed figures: <strong>MOQ, lead time, packaging options, certifications, and
      shipping terms.</strong>
    </p>

    <div class="callout">
      <strong>Request a quote</strong> — see our <a href="/request-a-quote/">quote request</a> page or
      <a href="/contact/">contact us</a> directly.
    </div>
  </article>
</BaseLayout>
