---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Request a Quote — LanDeng"
  description="Request a quote for Chinese botanical incense — samples, wholesale and OEM inquiries."
>
  <article class="article">
    <h1>Request a Quote</h1>
    <p class="lead">
      Tell us your requirements and we will respond with a confirmation of specifications, MOQ, and
      lead time.
    </p>

    <h2>What to include</h2>
    <ul>
      <li>Name</li>
      <li>Email</li>
      <li>Company (for wholesale/OEM)</li>
      <li>Country / region</li>
      <li>Product or ingredient interest</li>
      <li>Target quantity</li>
      <li>Specification or message</li>
    </ul>

    <div class="callout">
      <strong>Email your inquiry to:</strong> <code>contact@example.com</code>
      <!-- TODO: replace with the real contact email (MATERIAL-REQUESTS). The form backend is pending. -->
    </div>

    <p>
      <em>Note:</em> the online inquiry form is not yet live. For now, please email your details
      above and we will respond.
    </p>
  </article>
</BaseLayout>
