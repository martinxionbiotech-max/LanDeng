---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Contact — LanDeng"
  description="Contact LanDeng for Chinese botanical incense inquiries — samples, quotes, wholesale and OEM."
>
  <article class="article">
    <h1>Contact</h1>
    <p class="lead">
      For samples, quotes, wholesale, or OEM inquiries, reach out with your requirements and we will
      respond with a confirmation of specifications, MOQ, and lead time.
    </p>

    <h2>Inquiry types</h2>
    <ul>
      <li>Request a Sample</li>
      <li>Request a Quote</li>
      <li>Wholesale Inquiry</li>
      <li>OEM / Private Label Inquiry</li>
    </ul>

    <div class="callout">
      <strong>Email:</strong> <code>contact@example.com</code>
      <!-- TODO: replace with the real contact email (MATERIAL-REQUESTS) -->
    </div>

    <p>
      Please include: your name, company (if any), country/region, product interest, target quantity,
      and any specification — so we can route your inquiry correctly.
    </p>
  </article>
</BaseLayout>
