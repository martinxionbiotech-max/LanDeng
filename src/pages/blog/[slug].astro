---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({
    params: { slug: post.data.slug },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);

const { title, primary_keyword, search_intent, pillar, last_reviewed } = post.data;

// Extract FAQ Q&A from the markdown body to emit FAQPage structured data.
const faqMatch = (post.body || '').match(/## FAQ\s*\n([\s\S]*)$/);
let faqJsonLd = null;
if (faqMatch) {
  const qa: { '@type': 'Question'; name: string; acceptedAnswer: { '@type': 'Answer'; text: string } }[] = [];
  const re = /###\s*Q:\s*(.+?)\n([\s\S]*?)(?=\n###\s*Q:|\n##|$)/g;
  let m;
  while ((m = re.exec(faqMatch[1])) !== null) {
    const a = m[2].trim();
    if (a) qa.push({ '@type': 'Question', name: m[1].trim(), acceptedAnswer: { '@type': 'Answer', text: a } });
  }
  if (qa.length > 0) faqJsonLd = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: qa };
}

const SITE = Astro.site?.toString() ?? 'https://example.com';
const pageUrl = `${SITE}blog/${post.data.slug}/`;

const structuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'Article',
    '@id': `${pageUrl}#article`,
    headline: title,
    url: pageUrl,
    inLanguage: 'en',
    about: primary_keyword,
    articleSection: pillar,
    dateModified: last_reviewed,
    isPartOf: { '@id': `${SITE}#website` },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    '@id': `${pageUrl}#breadcrumb`,
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: SITE },
      { '@type': 'ListItem', position: 2, name: 'Guides', item: `${SITE}blog/` },
      { '@type': 'ListItem', position: 3, name: title, item: pageUrl },
    ],
  },
  ...(faqJsonLd ? [faqJsonLd] : []),
];
---

<BaseLayout title={`${title} — LanDeng`}>
  <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />

  <article class="guide-page">
    <header class="guide-header">
      <div class="shell prose">
        <nav class="breadcrumb" aria-label="Breadcrumb">
          <a href="/">Home</a><span aria-hidden="true">/</span>
          <a href="/blog/">Guides</a><span aria-hidden="true">/</span>
          <span aria-current="page">{title}</span>
        </nav>
        <p class="guide-meta">{pillar}</p>
        <h1>{title}</h1>
      </div>
    </header>

    <div class="shell article-layout">
      <div class="prose article-body">
        <Content />
      </div>
    </div>
  </article>
</BaseLayout>

<style>
  .guide-page {
    width: 100%;
  }

  .guide-header {
    padding-block: var(--space-6) var(--space-4);
    border-bottom: 1px solid var(--line);
  }

  .breadcrumb {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-bottom: var(--space-4);
    color: var(--ink-soft);
    font-size: 0.88rem;
  }

  .breadcrumb a {
    color: var(--ink-soft);
  }

  .guide-meta {
    margin: 0 0 var(--space-2);
    color: var(--amber);
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .guide-header h1 {
    margin: 0;
    font-family: var(--serif);
    font-size: clamp(1.7rem, 4vw, 2.6rem);
    line-height: 1.15;
  }

  .article-layout {
    padding-block: var(--space-6);
  }

  .article-body :global(h2) {
    margin-top: var(--space-6);
  }

  .article-body :global(table) {
    width: 100%;
    margin: var(--space-3) 0;
    border-collapse: collapse;
    font-size: 0.95rem;
  }

  .article-body :global(th),
  .article-body :global(td) {
    padding: 0.65rem 0.75rem;
    border-bottom: 1px solid var(--line);
    text-align: left;
    vertical-align: top;
  }

  .article-body :global(th) {
    color: var(--ink-soft);
    font-size: 0.8rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .article-body :global(blockquote) {
    margin: var(--space-4) 0;
    padding: var(--space-3) var(--space-4);
    border-left: 3px solid var(--amber);
    background: var(--paper-raise);
    color: var(--ink-soft);
  }

  .article-body :global(blockquote p:last-child) {
    margin-bottom: 0;
  }

  .article-body :global(a) {
    color: var(--amber);
  }

  .article-body :global(hr) {
    margin: var(--space-5) 0;
    border: 0;
    border-top: 1px solid var(--line);
  }
</style>
