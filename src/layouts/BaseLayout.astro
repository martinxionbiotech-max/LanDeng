---
interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'LanDeng — Chinese Botanical Incense',
  description = 'A quiet, research-led knowledge platform for Chinese botanical incense.',
} = Astro.props;

const SITE = Astro.site?.toString() ?? 'https://example.com';
const canonical = Astro.site
  ? new URL(Astro.url.pathname, Astro.site).toString()
  : `${SITE}${Astro.url.pathname}`;
const ogImage = `${SITE}og-image.png`; // TODO: replace with real brand image (MATERIAL-REQUESTS)

const orgJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  '@id': `${SITE}#organization`,
  name: 'LanDeng',
  alternateName: '澜灯',
  url: SITE,
  description: 'Chinese botanical incense knowledge platform.',
};

const webSiteJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  '@id': `${SITE}#website`,
  url: SITE,
  name: 'LanDeng',
  publisher: { '@id': `${SITE}#organization` },
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="generator" content={Astro.generator} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Source+Serif+4:opsz,wght@8..60,400;8..60,600;8..60,700&family=Noto+Serif+SC:wght@400;600&display=swap"
      rel="stylesheet"
    />
    <title>{title}</title>
    <meta property="og:site_name" content="LanDeng" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <script type="application/ld+json" set:html={JSON.stringify(orgJsonLd)} />
    <script type="application/ld+json" set:html={JSON.stringify(webSiteJsonLd)} />
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>

    <header class="site-header">
      <div class="shell">
        <a class="brand" href="/" aria-label="LanDeng home">
          <span class="brand-mark" aria-hidden="true">澜灯</span>
          <span class="brand-name">LanDeng</span>
        </a>
        <nav class="site-nav" aria-label="Primary navigation">
          <a href="/">Home</a>
          <a href="/ingredients/">Ingredients</a>
          <a href="/wholesale/">Wholesale</a>
          <a href="/oem/">OEM</a>
          <a href="/contact/">Contact</a>
        </nav>
      </div>
    </header>

    <main id="main-content" class="site-main">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="shell">
        <div>
          <p class="footer-brand">澜灯 <span>LanDeng</span></p>
          <p class="footer-note">
            Chinese botanical incense, documented in English with source transparency.
          </p>
        </div>
        <nav class="footer-links" aria-label="Footer navigation">
          <a href="/chinese-incense/">Chinese Incense</a>
          <a href="/ingredients/">Ingredients</a>
          <a href="/wholesale/">Wholesale</a>
          <a href="/oem/">OEM</a>
          <a href="/safety/">Safety</a>
          <a href="/contact/">Contact</a>
        </nav>
        <nav class="footer-links" aria-label="Machine-readable resources">
          <a href="/sitemap-index.xml">Sitemap</a>
          <a href="/llms.txt">llms.txt</a>
          <a href="/data/ingredients.json">Ingredient dataset</a>
          <a href="/data/terminology.json">Terminology dataset</a>
        </nav>
        <p class="copyright">© {new Date().getFullYear()} LanDeng</p>
      </div>
    </footer>
  </body>
</html>

<style is:global>
  :root {
    --ink: #1c1a17;
    --ink-soft: #55514a;
    --paper: #faf7f1;
    --paper-raise: #ffffff;
    --line: #e7e0d4;
    --amber: #b07a3f;
    --amber-soft: #f1e4d2;
    --jade: #5c7260;
    --wood: #8a6b4f;
    --danger: #a33d2f;

    --serif: 'Source Serif 4', 'Noto Serif SC', Georgia, 'Times New Roman', serif;
    --sans: Inter, 'Noto Serif SC', system-ui, -apple-system, BlinkMacSystemFont, sans-serif;

    --max-prose: 45rem;
    --max-shell: 72rem;
    --space-1: 0.5rem;
    --space-2: 1rem;
    --space-3: 1.5rem;
    --space-4: 2rem;
    --space-5: 3rem;
    --space-6: 4.5rem;
    --radius: 4px;
  }

  * {
    box-sizing: border-box;
  }

  html {
    background: var(--paper);
    color: var(--ink);
    font-family: var(--sans);
    font-size: 17px;
    line-height: 1.65;
    scroll-behavior: smooth;
  }

  body {
    margin: 0;
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    background:
      radial-gradient(circle at 80% 0%, rgba(176, 122, 63, 0.06), transparent 34rem),
      var(--paper);
  }

  a {
    color: var(--amber);
    text-underline-offset: 0.18em;
    text-decoration-thickness: 1px;
  }

  a:hover {
    color: var(--wood);
  }

  h1,
  h2,
  h3,
  h4 {
    color: var(--ink);
    font-family: var(--serif);
    font-weight: 600;
    line-height: 1.18;
    letter-spacing: -0.02em;
  }

  h1 {
    font-size: clamp(2.3rem, 5vw, 3.8rem);
    margin: 0 0 var(--space-3);
  }

  h2 {
    font-size: clamp(1.7rem, 3vw, 2.4rem);
    margin: var(--space-6) 0 var(--space-3);
  }

  h3 {
    font-size: 1.35rem;
    margin: var(--space-4) 0 var(--space-2);
  }

  p {
    margin: 0 0 var(--space-3);
  }

  .skip-link {
    position: absolute;
    left: 1rem;
    top: -3rem;
    z-index: 20;
    padding: 0.5rem 0.75rem;
    background: var(--ink);
    color: var(--paper);
    border-radius: var(--radius);
  }

  .skip-link:focus {
    top: 1rem;
  }

  .shell {
    width: min(var(--max-shell), calc(100% - 2.5rem));
    margin-inline: auto;
  }

  .prose {
    width: min(var(--max-prose), 100%);
  }

  .site-header {
    border-bottom: 1px solid var(--line);
    background: color-mix(in srgb, var(--paper) 88%, transparent);
    backdrop-filter: blur(8px);
    position: sticky;
    top: 0;
    z-index: 10;
  }

  .site-header .shell {
    min-height: 4rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
  }

  .brand {
    display: inline-flex;
    align-items: baseline;
    gap: 0.65rem;
    color: var(--ink);
    text-decoration: none;
    font-family: var(--serif);
  }

  .brand-mark {
    font-size: 1.35rem;
    font-weight: 600;
    letter-spacing: 0.08em;
  }

  .brand-name {
    font-size: 1.05rem;
    letter-spacing: 0.02em;
  }

  .site-nav {
    display: flex;
    align-items: center;
    gap: 1.35rem;
    font-size: 0.95rem;
  }

  .site-nav a,
  .footer-links a {
    color: var(--ink-soft);
    text-decoration: none;
  }

  .site-nav a:hover,
  .footer-links a:hover {
    color: var(--amber);
  }

  .site-main {
    flex: 1 0 auto;
    width: 100%;
  }

  .site-footer {
    margin-top: var(--space-6);
    border-top: 1px solid var(--line);
    background: color-mix(in srgb, var(--amber-soft) 34%, var(--paper));
  }

  .site-footer .shell {
    display: grid;
    grid-template-columns: 1.4fr 1fr;
    gap: var(--space-4);
    padding-block: var(--space-5) var(--space-4);
  }

  .footer-brand {
    margin: 0 0 var(--space-1);
    font-family: var(--serif);
    font-size: 1.3rem;
    font-weight: 600;
  }

  .footer-brand span {
    font-weight: 400;
    color: var(--ink-soft);
  }

  .footer-note {
    color: var(--ink-soft);
    font-size: 0.94rem;
    max-width: 34rem;
  }

  .footer-links {
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
    font-size: 0.94rem;
  }

  .copyright {
    grid-column: 1 / -1;
    margin: var(--space-2) 0 0;
    color: var(--ink-soft);
    font-size: 0.82rem;
  }

  :focus-visible {
    outline: 2px solid var(--amber);
    outline-offset: 3px;
  }

  @media (max-width: 44rem) {
    .site-footer .shell {
      grid-template-columns: 1fr;
    }

    .copyright {
      grid-column: auto;
    }
  }
</style>
